# ==========================================
# SaveState — Environment Configuration
# ==========================================

# ------------------------------------------
# Cloudflare Workers API (apps/api)
# ------------------------------------------
# Port for local dev server (default 8787)
PORT=8787

# Gemini API Key (Secret for Cloudflare Workers)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (supports text & vision, Portuguese prompt)
# Default: gemini-3.5-flash-lite (fast, multimodal, free tier eligible)
# Alternative: gemini-3.8-flash (complex reasoning)
GEMINI_MODEL=gemini-3.5-flash-lite

# Catalog Provider Configuration
# RAWG API Key: https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# IGDB / Twitch Credentials (Optional alternative provider):
# https://api-docs.igdb.com/#about
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Rate Limiting & Abuse Controls
# Maximum AI requests per client IP / day
AI_DAILY_RATE_LIMIT=30
# Master switch to disable AI assistant during outages or budget capping (true/false)
AI_FEATURE_ENABLED=true

# ------------------------------------------
# Mobile Client (apps/mobile)
# ------------------------------------------
# Public URL for the backend API
# Local dev: http://10.0.2.2:8787 (Android emulator) or http://<YOUR_LAN_IP>:8787 (Physical device)
# Staging: https://savestate-api-staging.your-subdomain.workers.dev
# Production: https://api.savestate.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
