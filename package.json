{
  "name": "savestate-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SaveState — Android Game Backlog App with Game-Focused Text & Vision Assistant",
  "scripts": {
    "build": "pnpm --filter @savestate/shared build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "mobile:start": "pnpm --filter @savestate/mobile start",
    "mobile:android": "pnpm --filter @savestate/mobile android",
    "api:dev": "pnpm --filter @savestate/api dev",
    "api:deploy": "pnpm --filter @savestate/api deploy"
  },
  "devDependencies": {
    "babel-preset-expo": "~12.0.12",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
